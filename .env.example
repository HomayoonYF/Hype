# Token from @BotFather (required)
BOT_TOKEN=123456:put-your-token-here

# Your Telegram numeric user id(s), comma separated. Needed for /stats, /give, /fire and to get alerts about failed payments.
ADMIN_IDS=

# Where the game database lives
DB_PATH=hypemarket.db

# fa or en: default language for new groups and players
DEFAULT_LANG=fa

# 1/0 switches
SHOP_ENABLED=1
ALLOW_RUG=1
RANDOM_EVENTS=1
LOG_LEVEL=INFO

# Automated market traders (clearly labelled 🤖 accounts that keep prices moving): 1/0
MARKET_BOTS=1

# Only if Telegram is blocked where the bot runs, e.g. socks5://127.0.0.1:1080 or http://host:port
PROXY_URL=

# A verified database backup is sent to every ADMIN_IDS account once every BACKUP_EVERY_HOURS hours (default 24).
# Each admin must press /start in a private chat with the bot once. (The old BACKUP_EVERY_MIN setting is no longer used.)
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=30
BACKUP_DIR=backups
# UTC hour of the daily analytics report to the admins
REPORT_HOUR_UTC=5

# Daily salary DM (a morning summary with a claim button): 1/0, and the UTC hour it starts at
SALARY_DM=1
SALARY_HOUR_UTC=5

# The city map (v0.17): how fast players walk along the roads (map units per second; the city is about 1360 wide, so 10 = roughly two minutes
# to cross it), how close another player must be by ROAD distance to show on your map, and how long the buttons under a map message keep working.
WALK_SPEED=10
MAP_NEARBY_RADIUS=300
MAP_SESSION_HOURS=24

# Cash economy and side jobs (v0.18, all optional): the speed of the Snapp rental car (map units per second; walking is WALK_SPEED, so 20 = twice as fast),
# the time zone used to show a McDonald's shift's start and end as clock times (minutes added to UTC, 210 = Tehran), and whether a hug request needs both
# players to be near each other on the map (1 = yes, 0 = no).
CAR_SPEED=20
DISPLAY_UTC_OFFSET_MIN=210
HUG_NEED_NEAR=1

# v0.18.1: number style of everything the bot says. en (default) = 1,000 and 12%; fa brings the old Persian digits back (۱٬۰۰۰ and ۱۲٪).
DIGITS=en
# The daily bonus opens again at midnight of this time zone (minutes added to UTC; 210 = Tehran), not 24 hours after the last claim.
DAILY_UTC_OFFSET_MIN=210
