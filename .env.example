# Token from @BotFather (required)
BOT_TOKEN=123456:put-your-token-here

# Your Telegram numeric user id(s), comma separated. Needed for /stats, /give, /fire and to get alerts about failed payments.
ADMIN_IDS=

# Where the game database lives
DB_PATH=hypemarket.db

# fa or en: default language for new groups and players
DEFAULT_LANG=fa

# 1/0 switches
SHOP_ENABLED=1
ALLOW_RUG=1
RANDOM_EVENTS=1
LOG_LEVEL=INFO

# Automated market traders (clearly labelled 🤖 accounts that keep prices moving): 1/0
MARKET_BOTS=1

# Only if Telegram is blocked where the bot runs, e.g. socks5://127.0.0.1:1080 or http://host:port
PROXY_URL=
